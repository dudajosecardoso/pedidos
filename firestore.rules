rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{id} {
      // Substitua este e-mail pelo do administrador cadastrado no Authentication.
      function isAdmin() {
        return request.auth != null
          && request.auth.token.email == 'augusto@almocotonho.app';
      }
      function validOrder() {
        return request.resource.data.keys().hasOnly([
            'name', 'mode', 'title', 'members', 'items', 'shared', 'note', 'at'
          ])
          && request.resource.data.keys().hasAll([
            'name', 'mode', 'title', 'members', 'items', 'shared', 'note', 'at'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() < 80
          && request.resource.data.note is string
          && request.resource.data.note.size() < 500
          && request.resource.data.mode in ['ind', 'grp'];
      }
      // Compatibilidade v3: o participante não faz login.
      // ATENÇÃO: as gravações não são vinculadas à identidade do participante.
      // Consulte o README antes de usar em ambiente público.
      allow create, update: if validOrder();
      allow get, list, delete: if isAdmin();
    }
  }
}
